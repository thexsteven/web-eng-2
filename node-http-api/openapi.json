{
  "openapi": "3.0.3",
  "info": {
    "title": "Node.js HTTP-API",
    "description": "Eine einfache Benutzer-API mit dem nativen Node.js-http-Modul.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Aktueller Server"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Allgemein",
      "description": "Übersicht und Serverstatus"
    },
    {
      "name": "Benutzer",
      "description": "Benutzer lesen und anlegen"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["Allgemein"],
        "summary": "API-Übersicht anzeigen",
        "operationId": "getOverview",
        "responses": {
          "200": {
            "description": "HTML-Übersicht der verfügbaren Routen",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Allgemein"],
        "summary": "Serverstatus abrufen",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Der Server ist erreichbar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Benutzer"],
        "summary": "Alle Benutzer abrufen",
        "operationId": "getUsers",
        "responses": {
          "200": {
            "description": "Liste aller Benutzer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Benutzer"],
        "summary": "Neuen Benutzer anlegen",
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewUser"
              },
              "example": {
                "name": "Erika Mustermann",
                "role": "user"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Benutzer wurde angelegt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Benutzer"],
        "summary": "Einzelnen Benutzer abrufen",
        "operationId": "getUserById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Numerische Benutzer-ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Gefundener Benutzer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "Benutzer wurde nicht gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status", "uptime"],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "uptime": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "example": 12.34
          }
        }
      },
      "User": {
        "type": "object",
        "required": ["id", "name", "role"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Anna Schmidt"
          },
          "role": {
            "type": "string",
            "example": "admin"
          }
        }
      },
      "NewUser": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Ungültiger Request-Body",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
